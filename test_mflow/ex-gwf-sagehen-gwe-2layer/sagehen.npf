# Node property flow: GSFLOW's UPW conductivities in m/day (kh1, kh2, kv1, kv2.txt), converted to m/s.
# Layer 1 convertible, layer 2 confined, as GSFLOW's LAYTYP.
BEGIN OPTIONS
  SAVE_FLOWS
END OPTIONS

BEGIN GRIDDATA
  ICELLTYPE LAYERED
    CONSTANT  1
    CONSTANT  0
  K LAYERED
    OPEN/CLOSE  kh1.txt  FACTOR  1.15740740740741e-05
    OPEN/CLOSE  kh2.txt  FACTOR  1.15740740740741e-05
  K33 LAYERED
    OPEN/CLOSE  kv1.txt  FACTOR  1.15740740740741e-05
    OPEN/CLOSE  kv2.txt  FACTOR  1.15740740740741e-05
END GRIDDATA
