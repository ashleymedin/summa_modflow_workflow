# Storage: GSFLOW's UPW specific yield (sy1.txt, layer 1 only) and specific storage.
BEGIN OPTIONS
  SAVE_FLOWS
END OPTIONS

BEGIN GRIDDATA
  ICONVERT LAYERED
    CONSTANT  1
    CONSTANT  0
  SS LAYERED
    CONSTANT  2e-06
    CONSTANT  2e-06
  SY LAYERED
    OPEN/CLOSE  sy1.txt
    CONSTANT  0.0
END GRIDDATA

BEGIN PERIOD 1
  TRANSIENT
END PERIOD
